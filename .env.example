# Base URL of carmessievelvet-api, including its version prefix.
# The API always listens on port 3000 (hardcoded in its src/main.ts), so
# when running both projects locally, start this one on a different port,
# e.g. `npm run dev -- -p 3001` (already covered by the API's default CORS
# allowlist: http://localhost:3000 and http://localhost:3001).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1

# Absolute origin of this site (no trailing slash) — used for canonical
# URLs, Open Graph/Twitter absolute URLs, the sitemap, and JSON-LD. Falls
# back to the real production domain in code (`src/lib/site-url.ts`) if
# unset, so this only needs to be set explicitly for a non-production
# deploy (e.g. the staging domain).
NEXT_PUBLIC_SITE_URL=https://carmessievelvet.com.mx
